class Solution:
    def rob(self, nums: list[int]) -> int:
        """
        盗む。
        dp[n]は、dp[n-2] + nums[n]と、dp[n-1]の大きい方。
        漸化式で解く。
        """
        rob1 = 0
        rob2 = 0
        dp = [0] * len(nums)

        for i, num in enumerate(nums):
            rob1,rob2 = rob2, rob1 + num
            dp[i] = max(rob1, rob2)
        return dp[-1]
